# Copy to .env and fill in the blanks. .env is gitignored; never commit it.
# Every variable is required: application.yml has no defaults, so a missing
# line stops the app at startup.

# ==================== SECRETS (fill in) ====================

# Same value in every Premisave service that uses it (this one and wallet-service).
INTERNAL_SERVICE_API_KEY=

# Base64, 32 bytes decoded. Must match auth-service.
JWT_SECRET=

# SMTP for booking and interest emails. Gmail: use an App Password, host smtp.gmail.com, port 587.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# ==================== SERVICES ====================

AUTH_SERVICE_URL=http://localhost:8080
WALLET_SERVICE_URL=http://localhost:8084
MONGODB_URI=mongodb://localhost:27017/premisave-listing
REDIS_HOST=localhost
REDIS_PORT=6379
FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# ==================== WEB ====================

FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# "From" address on notification emails.
MAIL_FROM=no-reply@premisave.com

# ==================== IMAGE STORAGE ====================

# LOCAL stores images in STORAGE_ROOT. NETWORK uses a share already mounted at STORAGE_NETWORK_MOUNT_PATH.
STORAGE_MODE=LOCAL
STORAGE_ROOT=/home/graham218/MyProjects/file-storage/premisave-listing
# Public address of this service; saved inside image URLs on listings.
STORAGE_PUBLIC_BASE_URL=http://localhost:8082

# Used only when STORAGE_MODE=NETWORK. Keep the lines, leave blank if unused.
STORAGE_NETWORK_PROTOCOL=SMB
STORAGE_NETWORK_HOST=
STORAGE_NETWORK_SHARE=
STORAGE_NETWORK_MOUNT_PATH=
STORAGE_NETWORK_DIRECTORY=premisave-listing
STORAGE_NETWORK_REQUIRE_MOUNT=true

# ==================== ESCROW ====================

# true: wallet-service holds the payment until after check-in (needs its escrow endpoints).
# false: the tenant pays the owner directly.
ESCROW_ENABLED=false
# Hours after check-in before the owner is paid.
ESCROW_RELEASE_DELAY_HOURS=24

# ==================== OPTIONAL ====================

# JVM time zone, e.g. Africa/Nairobi. Leave the line commented out to use the server zone.
# APP_TIME_ZONE=
