# Copy this file to .env and fill in real values. .env itself is
# gitignored and should never be committed — this file (.env.example)
# is the one that gets checked in, so anyone cloning the repo knows
# exactly what needs to be set.

# ==================== REQUIRED — app fails to start without these ====================

# Shared internal-service API key — must be the EXACT SAME value across
# every Premisave microservice (currently: this service and
# wallet-service). Generate a real random value, don't leave this as-is.
INTERNAL_SERVICE_API_KEY=

# JWT signing secret — must match auth-service exactly (Base64-encoded,
# 32 bytes after decoding).
JWT_SECRET=

# Cloudinary credentials — get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP credentials for booking/interest notification emails. For Gmail,
# use an App Password (not your account password) — smtp.gmail.com, port
# 587. For a transactional provider (SendGrid, Mailgun, SES, Postmark,
# etc.), use whatever SMTP host/port/credentials they issue you.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# ==================== OPTIONAL — sensible defaults apply if unset ====================

# Defaults to http://localhost:8080
AUTH_SERVICE_URL=

# Defaults to http://localhost:8084
WALLET_SERVICE_URL=

# Defaults to mongodb://localhost:27017/premisave-listing
MONGODB_URI=

# Default to localhost:6379
REDIS_HOST=
REDIS_PORT=

# Defaults to https://api.frankfurter.dev
FRANKFURTER_BASE_URL=

# Defaults to http://localhost:3000
FRONTEND_URL=

# Comma-separated list, e.g. https://app.example.com,https://admin.example.com
# Falls back to FRONTEND_URL above if unset.
CORS_ALLOWED_ORIGINS=

# Defaults to no-reply@premisave.com — the "From" address on every
# booking/interest notification email.
MAIL_FROM=
